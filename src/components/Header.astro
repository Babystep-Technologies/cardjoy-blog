---
import Wordmark from './Wordmark.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/"><Wordmark /><span class="blog-label" aria-hidden="true">blog</span><span class="sr-only">{SITE_TITLE}</span></a></h2>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1.5em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
	}
	.blog-label {
		color: var(--black);
		align-self: flex-end;
		line-height: 1.2;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
